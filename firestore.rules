rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function allowedCollection(name) {
      return name in [
        'cuentas', 'tarjetas', 'personas', 'propietarios', 'instituciones',
        'categorias', 'movimientos', 'presupuestos', 'metas', 'deudas',
        'recurrentes', 'transferencias', 'pagosTarjeta', 'eventosContables'
      ];
    }

    function safeProfile() {
      return request.resource.data.keys().hasOnly([
        'displayName', 'email', 'currency', 'timeZone', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.displayName is string
      && request.resource.data.email is string
      && request.resource.data.currency in ['PEN', 'USD', 'EUR', 'GBP', 'JPY', 'CLP', 'COP', 'MXN', 'BRL']
      && request.resource.data.timeZone == 'America/Lima';
    }

    function safeMoneyFields() {
      return (!('montoMinor' in request.resource.data) || (request.resource.data.montoMinor is int && request.resource.data.montoMinor >= 0))
        && (!('saldoInicialMinor' in request.resource.data) || (request.resource.data.saldoInicialMinor is int && request.resource.data.saldoInicialMinor >= 0))
        && (!('saldoActualMinor' in request.resource.data) || request.resource.data.saldoActualMinor is int)
        && (!('lineaCreditoMinor' in request.resource.data) || (request.resource.data.lineaCreditoMinor is int && request.resource.data.lineaCreditoMinor >= 0))
        && (!('saldoInicialUsadoMinor' in request.resource.data) || (request.resource.data.saldoInicialUsadoMinor is int && request.resource.data.saldoInicialUsadoMinor >= 0))
        && (!('utilizadoMinor' in request.resource.data) || (request.resource.data.utilizadoMinor is int && request.resource.data.utilizadoMinor >= 0))
        && (!('limiteMinor' in request.resource.data) || (request.resource.data.limiteMinor is int && request.resource.data.limiteMinor >= 0))
        && (!('montoObjetivoMinor' in request.resource.data) || (request.resource.data.montoObjetivoMinor is int && request.resource.data.montoObjetivoMinor >= 0))
        && (!('montoActualMinor' in request.resource.data) || (request.resource.data.montoActualMinor is int && request.resource.data.montoActualMinor >= 0))
        && (!('montoTotalMinor' in request.resource.data) || (request.resource.data.montoTotalMinor is int && request.resource.data.montoTotalMinor >= 0))
        && (!('montoPagadoMinor' in request.resource.data) || (request.resource.data.montoPagadoMinor is int && request.resource.data.montoPagadoMinor >= 0))
        && (!('montoEstimadoMinor' in request.resource.data) || (request.resource.data.montoEstimadoMinor is int && request.resource.data.montoEstimadoMinor >= 0));
    }

    function safeDebtFields() {
      return (!('tipo_deuda' in request.resource.data) || request.resource.data.tipo_deuda in ['POR_PAGAR', 'POR_COBRAR'])
        && (!('origen_saldo' in request.resource.data) || request.resource.data.origen_saldo in ['SALDO_INICIAL', 'PRESTAMO_NUEVO'])
        && (!('principal_confirmado' in request.resource.data) || request.resource.data.principal_confirmado is bool)
        && (!('cuenta_id' in request.resource.data) || request.resource.data.cuenta_id == null || request.resource.data.cuenta_id is string)
        && (!('persona_id' in request.resource.data) || request.resource.data.persona_id == null || request.resource.data.persona_id is string)
        && (!('archivada' in request.resource.data) || request.resource.data.archivada is bool)
        && (!('montoTotalMinor' in request.resource.data) || !('montoPagadoMinor' in request.resource.data) || request.resource.data.montoPagadoMinor <= request.resource.data.montoTotalMinor);
    }

    function safeCollectionFields(collection) {
      return (!('moneda' in request.resource.data) || request.resource.data.moneda in ['PEN', 'USD', 'EUR', 'GBP', 'JPY', 'CLP', 'COP', 'MXN', 'BRL'])
        && (collection != 'movimientos' || ((!('tipo' in request.resource.data) || request.resource.data.tipo in ['INGRESO', 'GASTO'])
          && (!('medio_pago' in request.resource.data) || request.resource.data.medio_pago in ['EFECTIVO', 'CUENTA_BANCARIA', 'YAPE', 'PLIN', 'TARJETA_DEBITO', 'TARJETA_CREDITO', 'OTRO'])
          && (!('montoMinor' in request.resource.data) || request.resource.data.montoMinor > 0)))
        && (collection != 'transferencias' || ((!('montoMinor' in request.resource.data) || request.resource.data.montoMinor > 0)
          && (!('cuenta_origen_id' in request.resource.data) || request.resource.data.cuenta_origen_id is string)
          && (!('cuenta_destino_id' in request.resource.data) || request.resource.data.cuenta_destino_id is string)
          && (!('cuenta_origen_id' in request.resource.data) || !('cuenta_destino_id' in request.resource.data) || request.resource.data.cuenta_origen_id != request.resource.data.cuenta_destino_id)))
        && (collection != 'pagosTarjeta' || ((!('montoMinor' in request.resource.data) || request.resource.data.montoMinor > 0)
          && (!('cuenta_id' in request.resource.data) || request.resource.data.cuenta_id is string)
          && (!('tarjeta_id' in request.resource.data) || request.resource.data.tarjeta_id is string)))
        && (collection != 'tarjetas' || !('tipo' in request.resource.data) || request.resource.data.tipo in ['CREDITO', 'DEBITO']);
    }

    function requiredCreateFields(collection) {
      return (collection != 'movimientos' || (request.resource.data.keys().hasAll(['tipo', 'medio_pago', 'montoMinor', 'moneda']) && request.resource.data.tipo in ['INGRESO', 'GASTO'] && request.resource.data.montoMinor > 0))
        && (collection != 'transferencias' || (request.resource.data.keys().hasAll(['cuenta_origen_id', 'cuenta_destino_id', 'montoMinor', 'moneda']) && request.resource.data.montoMinor > 0 && request.resource.data.cuenta_origen_id != request.resource.data.cuenta_destino_id))
        && (collection != 'pagosTarjeta' || (request.resource.data.keys().hasAll(['cuenta_id', 'tarjeta_id', 'montoMinor', 'moneda']) && request.resource.data.montoMinor > 0))
        && (collection != 'deudas' || request.resource.data.keys().hasAll(['tipo_deuda', 'origen_saldo', 'principal_confirmado']));
    }

    function eventPath(uid, eventId) {
      return /databases/$(database)/documents/users/$(uid)/eventosContables/$(eventId);
    }

    function validBalancePointer(uid, collection, documentId, data) {
      return data.ultimoEventoContableId is string
        && data.ultimaOperacionContableId is string
        && !exists(eventPath(uid, data.ultimoEventoContableId))
        && existsAfter(eventPath(uid, data.ultimoEventoContableId))
        && getAfter(eventPath(uid, data.ultimoEventoContableId)).data.operacionId == data.ultimaOperacionContableId
        && ((collection == 'cuentas' && getAfter(eventPath(uid, data.ultimoEventoContableId)).data.cuentaId == documentId)
          || (collection == 'tarjetas' && getAfter(eventPath(uid, data.ultimoEventoContableId)).data.operacionSnapshot.get('tarjeta_id', null) == documentId)
          || (collection == 'deudas' && getAfter(eventPath(uid, data.ultimoEventoContableId)).data.deudaId == documentId));
    }

    function balanceChangeHasEvent(uid, collection, documentId) {
      let afterData = request.resource.data;
      return validBalancePointer(uid, collection, documentId, afterData)
        && (collection != 'cuentas' || getAfter(eventPath(uid, afterData.ultimoEventoContableId)).data.cuentaId == documentId)
        && (collection != 'tarjetas' || getAfter(eventPath(uid, afterData.ultimoEventoContableId)).data.operacionSnapshot.get('tarjeta_id', null) == documentId)
        && (collection != 'deudas' || getAfter(eventPath(uid, afterData.ultimoEventoContableId)).data.operacionSnapshot.get('deudaId', null) == documentId);
    }

    function ledgerEventValid(uid, collection, documentId, data) {
      return data.eventoContableId is string
        && !exists(eventPath(uid, data.eventoContableId))
        && existsAfter(eventPath(uid, data.eventoContableId))
        && getAfter(eventPath(uid, data.eventoContableId)).data.operacionColeccion == collection
        && getAfter(eventPath(uid, data.eventoContableId)).data.operacionId == documentId
        && ((collection == 'movimientos' && getAfter(eventPath(uid, data.eventoContableId)).data.eventoTipo == 'MOVIMIENTO'
              && getAfter(eventPath(uid, data.eventoContableId)).data.operacionSnapshot.montoMinor == data.montoMinor
              && getAfter(eventPath(uid, data.eventoContableId)).data.operacionSnapshot.tipo == data.tipo
              && getAfter(eventPath(uid, data.eventoContableId)).data.cuentaId == data.get('cuenta_id', null))
          || (collection == 'transferencias' && getAfter(eventPath(uid, data.eventoContableId)).data.eventoTipo == 'TRANSFERENCIA'
              && getAfter(eventPath(uid, data.eventoContableId)).data.operacionSnapshot.montoMinor == data.montoMinor
              && getAfter(eventPath(uid, data.eventoContableId)).data.operacionSnapshot.cuenta_origen_id == data.cuenta_origen_id
              && getAfter(eventPath(uid, data.eventoContableId)).data.operacionSnapshot.cuenta_destino_id == data.cuenta_destino_id)
          || (collection == 'pagosTarjeta' && getAfter(eventPath(uid, data.eventoContableId)).data.eventoTipo == 'PAGO_TARJETA'
              && getAfter(eventPath(uid, data.eventoContableId)).data.operacionSnapshot.montoMinor == data.montoMinor
              && getAfter(eventPath(uid, data.eventoContableId)).data.operacionSnapshot.get('tarjeta_id', null) == data.tarjeta_id
              && getAfter(eventPath(uid, data.eventoContableId)).data.cuentaId == data.cuenta_id));
    }

    function auditedAnnulment(uid, collection, documentId, data) {
      return data.anulada == true
        && data.eventoAnulacionId is string
        && !exists(eventPath(uid, data.eventoAnulacionId))
        && existsAfter(eventPath(uid, data.eventoAnulacionId))
        && getAfter(eventPath(uid, data.eventoAnulacionId)).data.operacionColeccion == collection
        && getAfter(eventPath(uid, data.eventoAnulacionId)).data.operacionId == documentId
        && getAfter(eventPath(uid, data.eventoAnulacionId)).data.eventoTipo == 'REVERSIÓN'
        && getAfter(eventPath(uid, data.eventoAnulacionId)).data.eventoRelacionadoId == resource.data.get('eventoContableId', null);
    }

    function linkedThroughAccount(uid, eventId, eventData) {
      let ref = /databases/$(database)/documents/users/$(uid)/cuentas/$(eventData.cuentaId);
      return eventData.cuentaId is string && existsAfter(ref)
        && getAfter(ref).data.ultimaOperacionContableId == eventData.operacionId
        && getAfter(ref).data.ultimoEventoContableId is string
        && !exists(eventPath(uid, getAfter(ref).data.ultimoEventoContableId))
        && existsAfter(eventPath(uid, getAfter(ref).data.ultimoEventoContableId))
        && getAfter(eventPath(uid, getAfter(ref).data.ultimoEventoContableId)).data.operacionId == eventData.operacionId;
    }

    function linkedThroughCard(uid, eventId, eventData) {
      let cardId = eventData.operacionSnapshot.get('tarjeta_id', null);
      let ref = /databases/$(database)/documents/users/$(uid)/tarjetas/$(cardId);
      return cardId is string && existsAfter(ref)
        && getAfter(ref).data.ultimaOperacionContableId == eventData.operacionId
        && getAfter(ref).data.ultimoEventoContableId is string
        && !exists(eventPath(uid, getAfter(ref).data.ultimoEventoContableId))
        && existsAfter(eventPath(uid, getAfter(ref).data.ultimoEventoContableId))
        && getAfter(eventPath(uid, getAfter(ref).data.ultimoEventoContableId)).data.operacionId == eventData.operacionId;
    }

    function linkedThroughDebt(uid, eventId, eventData) {
      let ref = /databases/$(database)/documents/users/$(uid)/deudas/$(eventData.deudaId);
      return eventData.deudaId is string && existsAfter(ref)
        && getAfter(ref).data.ultimaOperacionContableId == eventData.operacionId
        && getAfter(ref).data.ultimoEventoContableId is string
        && !exists(eventPath(uid, getAfter(ref).data.ultimoEventoContableId))
        && existsAfter(eventPath(uid, getAfter(ref).data.ultimoEventoContableId))
        && getAfter(eventPath(uid, getAfter(ref).data.ultimoEventoContableId)).data.operacionId == eventData.operacionId;
    }

    function eventIsLinked(uid, eventId, eventData) {
      return (eventData.cuentaId is string && linkedThroughAccount(uid, eventId, eventData))
        || (eventData.operacionSnapshot.get('tarjeta_id', null) is string && linkedThroughCard(uid, eventId, eventData))
        || (eventData.deudaId is string && linkedThroughDebt(uid, eventId, eventData))
        || ((eventData.operacionColeccion == 'movimientos' || eventData.operacionColeccion == 'transferencias' || eventData.operacionColeccion == 'pagosTarjeta')
          && existsAfter(/databases/$(database)/documents/users/$(uid)/$(eventData.operacionColeccion)/$(eventData.operacionId))
          && (getAfter(/databases/$(database)/documents/users/$(uid)/$(eventData.operacionColeccion)/$(eventData.operacionId)).data.eventoContableId == eventId
            || getAfter(/databases/$(database)/documents/users/$(uid)/$(eventData.operacionColeccion)/$(eventData.operacionId)).data.eventoAnulacionId == eventId));
    }

    function safeAccountingEvent(uid, eventId) {
      return request.resource.data.keys().hasOnly([
          'cuentaId', 'deudaId', 'operacionColeccion', 'operacionId', 'eventoTipo',
          'montoDeltaMinor', 'deltaPrincipalMinor', 'deltaResultadoMinor', 'deltaIngresoMinor', 'deltaGastoMinor', 'moneda',
          'fechaEfectiva', 'impactoResultado', 'componenteDeuda', 'eventoRelacionadoId',
          'motivo', 'operacionSnapshot', 'registradoEn', 'creadoEn'
        ])
        && request.resource.data.keys().hasAll([
          'cuentaId', 'deudaId', 'operacionColeccion', 'operacionId', 'eventoTipo',
          'montoDeltaMinor', 'deltaPrincipalMinor', 'deltaResultadoMinor', 'deltaIngresoMinor', 'deltaGastoMinor', 'moneda',
          'fechaEfectiva', 'impactoResultado', 'componenteDeuda', 'eventoRelacionadoId',
          'motivo', 'operacionSnapshot', 'registradoEn', 'creadoEn'
        ])
        && (request.resource.data.cuentaId == null || (request.resource.data.cuentaId is string && existsAfter(/databases/$(database)/documents/users/$(uid)/cuentas/$(request.resource.data.cuentaId))))
        && (request.resource.data.deudaId == null || (request.resource.data.deudaId is string && existsAfter(/databases/$(database)/documents/users/$(uid)/deudas/$(request.resource.data.deudaId))))
        && request.resource.data.operacionColeccion in ['cuentas', 'tarjetas', 'deudas', 'movimientos', 'transferencias', 'pagosTarjeta']
        && request.resource.data.operacionId is string
        && request.resource.data.eventoTipo in ['SALDO_BASE', 'MOVIMIENTO', 'TRANSFERENCIA', 'PAGO_TARJETA', 'PRESTAMO', 'PAGO_PRINCIPAL', 'INTERES', 'COMISION', 'REVERSIÓN', 'AJUSTE']
        && request.resource.data.montoDeltaMinor is int
        && request.resource.data.deltaPrincipalMinor is int
        && request.resource.data.deltaResultadoMinor is int
        && request.resource.data.deltaIngresoMinor is int
        && request.resource.data.deltaGastoMinor is int
        && request.resource.data.moneda in ['PEN', 'USD', 'EUR', 'GBP', 'JPY', 'CLP', 'COP', 'MXN', 'BRL']
        && request.resource.data.fechaEfectiva is string
        && request.resource.data.impactoResultado in ['INGRESO', 'GASTO', 'NINGUNO']
        && (request.resource.data.componenteDeuda == null || request.resource.data.componenteDeuda in ['PRINCIPAL', 'INTERES', 'COMISION'])
        && (request.resource.data.eventoRelacionadoId == null || request.resource.data.eventoRelacionadoId is string)
        && (request.resource.data.motivo == null || request.resource.data.motivo is string)
        && request.resource.data.operacionSnapshot is map
        && request.resource.data.registradoEn == request.time
        && request.resource.data.creadoEn == request.time
        && eventIsLinked(uid, eventId, request.resource.data);
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && safeProfile();
      allow update: if signedInAs(uid) && safeProfile()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /{collection}/{documentId} {
        allow read: if signedInAs(uid) && allowedCollection(collection);
        allow create: if signedInAs(uid) && allowedCollection(collection) && collection != 'eventosContables' && safeMoneyFields() && safeCollectionFields(collection) && requiredCreateFields(collection) && (collection != 'deudas' || safeDebtFields())
          && (collection != 'movimientos' && collection != 'transferencias' && collection != 'pagosTarjeta' || ledgerEventValid(uid, collection, documentId, request.resource.data))
          && (collection != 'cuentas' || request.resource.data.saldoActualMinor == 0 || (validBalancePointer(uid, collection, documentId, request.resource.data) && getAfter(eventPath(uid, request.resource.data.ultimoEventoContableId)).data.eventoTipo == 'SALDO_BASE' && getAfter(eventPath(uid, request.resource.data.ultimoEventoContableId)).data.montoDeltaMinor == request.resource.data.saldoActualMinor))
          && (collection != 'tarjetas' || request.resource.data.get('utilizadoMinor', 0) == 0 || (validBalancePointer(uid, collection, documentId, request.resource.data) && getAfter(eventPath(uid, request.resource.data.ultimoEventoContableId)).data.deltaPrincipalMinor == request.resource.data.utilizadoMinor))
          && (collection != 'deudas' || (validBalancePointer(uid, collection, documentId, request.resource.data)
            && getAfter(eventPath(uid, request.resource.data.ultimoEventoContableId)).data.eventoTipo == (request.resource.data.origen_saldo == 'PRESTAMO_NUEVO' ? 'PRESTAMO' : 'SALDO_BASE')
            && getAfter(eventPath(uid, request.resource.data.ultimoEventoContableId)).data.operacionSnapshot.montoTotalMinor == request.resource.data.montoTotalMinor))
          && (collection != 'tarjetas' || !('archivada' in request.resource.data) || request.resource.data.archivada is bool);
        allow update: if signedInAs(uid) && allowedCollection(collection) && collection != 'eventosContables' && safeMoneyFields() && safeCollectionFields(collection) && (collection != 'deudas' || safeDebtFields())
          && (collection != 'tarjetas' || !('archivada' in request.resource.data) || request.resource.data.archivada is bool)
          && (collection != 'cuentas' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['saldoActualMinor', 'saldoInicialMinor', 'ultimoEventoContableId', 'ultimaOperacionContableId']) || balanceChangeHasEvent(uid, collection, documentId))
          && (collection != 'tarjetas' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['utilizadoMinor', 'saldoInicialUsadoMinor', 'ultimoEventoContableId', 'ultimaOperacionContableId']) || balanceChangeHasEvent(uid, collection, documentId))
          && (collection != 'deudas' || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['montoTotalMinor']) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['montoPagadoMinor', 'ultimoEventoContableId', 'ultimaOperacionContableId']) || (validBalancePointer(uid, collection, documentId, request.resource.data) && getAfter(eventPath(uid, request.resource.data.ultimoEventoContableId)).data.operacionSnapshot.principalMinor == (request.resource.data.get('montoPagadoMinor', 0) - resource.data.get('montoPagadoMinor', 0))))))
          && (collection != 'deudas' || request.resource.data.get('archivada', false) != true || request.resource.data.montoPagadoMinor >= request.resource.data.montoTotalMinor)
          && (collection != 'movimientos' && collection != 'transferencias' && collection != 'pagosTarjeta' || (ledgerEventValid(uid, collection, documentId, request.resource.data) || auditedAnnulment(uid, collection, documentId, request.resource.data)))
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if signedInAs(uid) && collection in ['personas', 'propietarios', 'instituciones', 'categorias', 'presupuestos', 'metas', 'recurrentes'];
      }

      match /eventosContables/{eventId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid) && safeAccountingEvent(uid, eventId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
