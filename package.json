{
  "name": "masterfull-finanzas-local-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:finance": "node --test tests/finance.test.mjs",
    "test:indexes": "node --test tests/firestore-indexes.test.mjs",
    "test:navigation": "node --test tests/navigation.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-masterfull-local --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "test": "npm run test:finance && npm run test:indexes && npm run test:navigation && npm run test:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.1"
  }
}
